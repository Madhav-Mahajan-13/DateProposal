# Local development uses data/responses.json without these variables.
# On Vercel, connect a PRIVATE Blob store in the Storage tab.
# Vercel supplies BLOB_STORE_ID (OIDC) or BLOB_READ_WRITE_TOKEN automatically.
# Never prefix credentials with VITE_.

# Optional: use a custom private document path.
# Default: biscuit/<VERCEL_ENV or development>/responses.json
# BLOB_RESPONSES_PATH=biscuit/production/responses.json

# Optional for the standalone Node server:
# RESPONSES_FILE=data/responses.json
# COOKIE_SECURE=true
